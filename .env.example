# --- audio calls (LiveKit). Leave the key empty to run without calls (upload-only mode).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=qadam-dev-secret-change-me-0123456789abcdef
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880

# --- speech-to-text (faster-whisper)
WHISPER_MODEL=small        # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu         # cpu | cuda
WHISPER_COMPUTE_TYPE=int8  # int8 for CPU, float16 for GPU
WHISPER_LANGUAGE=          # empty = auto-detect; or ru / kk / en

# --- NLP step: placeholder = regex stub, none = no drafts at all
DRAFTER=placeholder

# --- misc
SEED_DEMO=true
DATABASE_URL=sqlite:///./data/qadam.db
RECORDINGS_DIR=./data/recordings
CORS_ORIGINS=http://localhost:5173
